<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="740.0" prefWidth="780.0" minHeight="720.0" minWidth="740.0" styleClass="bg-main" stylesheets="@../style.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.ukondy.photo.PhotoController">
    <children>
        <StackPane styleClass="window-wrapper">
            <children>
                <VBox styleClass="app-container" alignment="TOP_CENTER">
                    <children>

                        <!-- Верхняя навигация -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" maxWidth="1.7976931348623157E308" styleClass="nav-menu">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="24.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Button fx:id="btnSettings" mnemonicParsing="false" onAction="#handleDefaultSettings" styleClass="nav-item" text="Настройки" />
                                        <Button fx:id="btnHelp" mnemonicParsing="false" onAction="#openTutorial" styleClass="nav-item" text="Помощь" />
                                    </children>
                                </HBox>
                                <Button fx:id="btnExit" mnemonicParsing="false" onAction="#handleExit" styleClass="nav-item, btn-exit" text="Выход" alignment="CENTER_RIGHT" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="32.0" />
                            </VBox.margin>
                        </HBox>

                        <!-- Заголовок приложения -->
                        <VBox spacing="8.0" styleClass="header" maxWidth="1.7976931348623157E308" alignment="TOP_LEFT">
                            <children>
                                <Label styleClass="header-title" text="Объединение изображений" />
                                <Label styleClass="header-subtitle" text="Локальное склеивание ваших готовых фотографий в один файл" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="32.0" />
                            </VBox.margin>
                        </VBox>
                        <!-- Форма ввода -->
                        <VBox spacing="24.0" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- Режим работы (Выбран пункт Фото) -->
                                <VBox spacing="10.0" styleClass="form-group" alignment="TOP_LEFT">
                                    <children>
                                        <Label styleClass="form-label" text="Режим загрузки:" />
                                        <HBox maxWidth="1.7976931348623157E308" prefHeight="46.0" styleClass="segmented-control">
                                            <children>
                                                <RadioButton fx:id="modeSite" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchToSiteMode" styleClass="segment-option" text="С сайта" HBox.hgrow="ALWAYS">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="modeGroup" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="modeCustom" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchToCustomMode" styleClass="segment-option" text="Кастомный" toggleGroup="$modeGroup" HBox.hgrow="ALWAYS" />
                                                <RadioButton fx:id="modePhoto" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="segment-option" text="Фото" toggleGroup="$modeGroup" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- БОЛЬШОЙ БЛОК ГАЛЕРЕИ -->
                                <VBox spacing="10.0" styleClass="form-group" alignment="TOP_LEFT">
                                    <children>
                                        <Label styleClass="form-label" text="Загруженное изображения для склейки:" />
                                        <VBox styleClass="gallery-container" maxWidth="1.7976931348623157E308" spacing="12.0">
                                            <children>

                                                <!-- Шапка галереи со статистикой -->
                                                <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
                                                    <children>
                                                        <Label fx:id="lblTotalItems" text="Всего элементов: 0 изобр." style="-fx-text-fill: #8e8e93; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                                        <Label text="Формат: Сверху-Вниз" style="-fx-text-fill: #8e8e93; -fx-font-size: 13px;" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <!-- Область прокрутки карточек -->
                                                <ScrollPane fx:id="scrollGallery" fitToHeight="true" prefHeight="160.0" styleClass="gallery-scroll" maxWidth="1.7976931348623157E308" vbarPolicy="NEVER">
                                                    <content>
                                                        <HBox fx:id="boxImagesContainer" alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: transparent;">
                                                            <padding>
                                                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                                                            </padding>
                                                        </HBox>
                                                    </content>
                                                </ScrollPane>

                                                <!-- Панель инструментов под галереей -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" maxWidth="1.7976931348623157E308" style="-fx-border-color: #323238 transparent transparent transparent; -fx-border-width: 1px; -fx-padding: 12px 0 0 0;">
                                                    <children>
                                                        <Button fx:id="btnAddPhoto" mnemonicParsing="false" onAction="#handleAddPhoto" styleClass="btn-secondary" text="Добавить фото" />
                                                        <Button fx:id="btnDeletePhoto" mnemonicParsing="false" onAction="#handleDeletePhoto" styleClass="btn-danger" text="Удалить" />
                                                        <Button fx:id="btnSort" mnemonicParsing="false" onAction="#handleSort" styleClass="btn-secondary" text="Сортировка (1..3)" />

                                                        <HBox alignment="CENTER_RIGHT" spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Зазор:" style="-fx-text-fill: #8e8e93; -fx-font-size: 13px;" />
                                                                <TextField fx:id="inputGap" prefWidth="60.0" text="0" styleClass="text-input" style="-fx-padding: 6px; -fx-alignment: center; -fx-font-size: 13px;" />
                                                                <Label text="пкс" style="-fx-text-fill: #8e8e93; -fx-font-size: 13px;" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                <!-- Выбор формата преобразования -->
                                <VBox spacing="10.0" styleClass="form-group" alignment="TOP_LEFT">
                                    <children>
                                        <Label styleClass="form-label" text="Преобразовать в:" />
                                        <HBox maxWidth="1.7976931348623157E308" prefHeight="46.0" styleClass="segmented-control">
                                            <children>
                                                <RadioButton fx:id="formatPng" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="segment-option" text="Большое фото (PNG)" HBox.hgrow="ALWAYS">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="formatGroup" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="formatPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="segment-option" text="PDF документ" toggleGroup="$formatGroup" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Выбор папки для сохранения результата -->
                                <VBox spacing="10.0" styleClass="form-group" alignment="TOP_LEFT">
                                    <children>
                                        <Label styleClass="form-label" text="Куда сохранить созданный файл:" />
                                        <TextField fx:id="inputSavePath" editable="false" maxWidth="1.7976931348623157E308" onMouseClicked="#selectFolder" promptText="Нажмите для выбора папки..." styleClass="text-input, path-input" text="C:/Downloads/ParserOutput/Merged" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Главная кнопка склейки -->
                        <Button fx:id="btnExecute" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleExecute" prefHeight="54.0" styleClass="submit-btn" text="ВЫПОЛНИТЬ СКЛЕЙКУ">
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </Button>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</StackPane>
